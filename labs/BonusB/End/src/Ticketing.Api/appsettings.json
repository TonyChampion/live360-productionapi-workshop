{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://support.ticketing.example"
    ]
  },
  "RateLimits": {
    "CreateTicket": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },
  "HealthChecks": {
    "Store": {
      "DegradedMs": 500,
      "TimeoutMs": 2000
    }
  },
  "Resilience": {
    "RequestTimeoutMs": 5000,
    "StoreTotalTimeoutMs": 2500,
    "StoreAttemptTimeoutMs": 1000,
    "StoreMaxRetries": 2,
    "StoreRetryDelayMs": 100,
    "BreakerFailureRatio": 0.5,
    "BreakerMinimumThroughput": 10,
    "BreakerSamplingSeconds": 30,
    "BreakDurationSeconds": 15
  },
  "Jobs": {
    "MaxAttempts": 3,
    "RetryDelayMs": 1000
  },
  "Webhooks": {
    "MaxRetries": 3,
    "RetryDelayMs": 2000,
    "AttemptTimeoutSeconds": 10
  },
  "Sla": {
    "FirstResponseMinutes": 60,
    "ScanIntervalMs": 30000
  }
}
